// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildOverlayHtml > gera o snapshot hit × frame > hit-frame 1`] = `
"<div id="pfx-snap" class="pfx-root" aria-hidden="true">
  <div class="pfx-sheet"></div>
</div>
<style>
#pfx-snap.pfx-root{position:absolute;inset:0;overflow:hidden;pointer-events:none;isolation:isolate;contain:layout paint style;container-type:size;background:transparent;}
#pfx-snap .pfx-sheet{position:absolute;inset:0;opacity:0;will-change:opacity;background:transparent;box-shadow:inset 0 0 5.03vmin 3vmin #35e0ff;animation:pfx-snap-anim 420ms cubic-bezier(.12,.74,.3,1) 0ms 1 normal forwards;}
@keyframes pfx-snap-anim{0%{opacity:0.8;}100%{opacity:0;}}
</style>"
`;

exports[`buildOverlayHtml > gera o snapshot hit × full > hit-full 1`] = `
"<div id="pfx-snap" class="pfx-root" aria-hidden="true">
  <div class="pfx-sheet"></div>
</div>
<style>
#pfx-snap.pfx-root{position:absolute;inset:0;overflow:hidden;pointer-events:none;isolation:isolate;contain:layout paint style;container-type:size;background:transparent;}
#pfx-snap .pfx-sheet{position:absolute;inset:0;opacity:0;will-change:opacity;background:#35e0ff;animation:pfx-snap-anim 420ms cubic-bezier(.12,.74,.3,1) 0ms 1 normal forwards;}
@keyframes pfx-snap-anim{0%{opacity:0.8;}100%{opacity:0;}}
</style>"
`;

exports[`buildOverlayHtml > gera o snapshot hit × vignette > hit-vignette 1`] = `
"<div id="pfx-snap" class="pfx-root" aria-hidden="true">
  <div class="pfx-sheet"></div>
</div>
<style>
#pfx-snap.pfx-root{position:absolute;inset:0;overflow:hidden;pointer-events:none;isolation:isolate;contain:layout paint style;container-type:size;background:transparent;}
#pfx-snap .pfx-sheet{position:absolute;inset:0;opacity:0;will-change:opacity;background:transparent;background-image:radial-gradient(ellipse at center, rgba(53, 224, 255, 0) 0%, rgba(53, 224, 255, 0) 60%, #35e0ff 86%, #35e0ff 100%);animation:pfx-snap-anim 420ms cubic-bezier(.12,.74,.3,1) 0ms 1 normal forwards;}
@keyframes pfx-snap-anim{0%{opacity:0.8;}100%{opacity:0;}}
</style>"
`;

exports[`buildOverlayHtml > gera o snapshot pulse × frame > pulse-frame 1`] = `
"<div id="pfx-snap" class="pfx-root" aria-hidden="true">
  <div class="pfx-sheet"></div>
</div>
<style>
#pfx-snap.pfx-root{position:absolute;inset:0;overflow:hidden;pointer-events:none;isolation:isolate;contain:layout paint style;container-type:size;background:transparent;}
#pfx-snap .pfx-sheet{position:absolute;inset:0;opacity:0;will-change:opacity;background:transparent;box-shadow:inset 0 0 5.03vmin 3vmin #35e0ff;animation:pfx-snap-anim 500ms ease-in-out 0ms infinite normal none;}
@keyframes pfx-snap-anim{0%{opacity:0;}50%{opacity:0.8;}100%{opacity:0;}}
</style>"
`;

