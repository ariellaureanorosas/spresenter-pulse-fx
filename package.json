{
  "name": "com.spresenter.pulse-fx",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Pulse FX — efeitos de luz ao vivo para o Spresenter.",
  "author": "Ariel Laureano Rosas",
  "license": "MIT",
  "homepage": "https://github.com/ariellaureanorosas/spresenter-pulse-fx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariellaureanorosas/spresenter-pulse-fx.git"
  },
  "bugs": {
    "url": "https://github.com/ariellaureanorosas/spresenter-pulse-fx/issues"
  },
  "keywords": [
    "spresenter",
    "spresenter-plugin",
    "live",
    "lighting",
    "strobe",
    "pulse",
    "typescript"
  ],
  "scripts": {
    "build:code": "vite build --config vite.code.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build": "npm run build:code && npm run build:ui",
    "package": "npm run build && node scripts/package.mjs",
    "package:folder": "npm run build && node scripts/package.mjs --folder",
    "dev": "concurrently -k \"npm:watch:code\" \"npm:watch:ui\"",
    "watch:code": "vite build --watch --config vite.code.config.ts",
    "watch:ui": "vite build --watch --config vite.ui.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "verify:manifest": "node scripts/validate-manifest.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "verify": "npm run check && npm run typecheck && npm run test:coverage && npm run verify:sdk && npm run verify:manifest && npm run package"
  },
  "dependencies": {
    "@spresenter/plugin-sdk": "file:sdk/spresenter-plugin-sdk.tgz",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "adm-zip": "^0.6.1",
    "concurrently": "^8.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0"
}
